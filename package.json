{
  "name": "lab-learning",
  "private": true,
  "type": "module",
  "workspaces": [
    "research",
    "learning"
  ],
  "scripts": {
    "build": "npm run build --workspaces && node scripts/assemble.mjs",
    "check": "npm run check --workspace learning && npm run build --workspace research && node scripts/check-research.mjs",
    "dev": "npm run build && node scripts/preview.mjs",
    "dev:learning": "npm run dev --workspace learning"
  }
}
